{
  "name": "Northside Coffee",
  "tagline": "Brew bold.",
  "handle": "@northsidecoffee",
  "fonts": {
    "display": { "family": "Fraunces", "weight": 800, "google": "Fraunces:opsz,wght@9..144,600;9..144,800" },
    "body": { "family": "Inter", "weight": 400, "google": "Inter:wght@400;600;700" }
  },
  "palettes": {
    "espresso": { "bg": "#1E1915", "fg": "#F5EDE3", "accent": "#E8833A", "muted": "#B5A797", "ctaText": "#1E1915" },
    "cream":    { "bg": "#F4ECE1", "fg": "#2A211B", "accent": "#C4562A", "muted": "#7D6E60", "ctaText": "#F4ECE1" },
    "ember":    { "bg": "#C4562A", "fg": "#FFF6EC", "accent": "#2A211B", "muted": "#F2C9A8", "ctaBg": "#FFF6EC", "ctaText": "#C4562A" }
  },
  "logo": "assets/logo.svg",
  "style": { "headlineCase": "none", "headlineTracking": "-0.025em", "headlineLeading": 0.98, "radius": 999, "overlay": 0.5, "grain": true, "align": "left" },
  "defaults": { "templates": ["headline", "insight"], "formats": "social", "palettes": ["espresso"] },
  "captions": {
    "voice": "Warm, a little cheeky, neighbourhood-proud. Short sentences. Coffee nerd but never snobby.",
    "hashtags": ["NorthsideCoffee", "BrewBold", "CoffeeLovers", "LocalCoffee"],
    "signoff": "☕ Northside Coffee — Brew bold.",
    "link": "https://northside.coffee",
    "emoji": true
  }
}
